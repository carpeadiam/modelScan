# Copy to .env (never commit .env). No credentials belong here: use `gcloud auth application-default login`.
PG_USE_GCP=false
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
PG_BUCKET=your-project-id-pipelineguard
PG_BUILD_REGION=global
PG_SERVICE_NAME=pipelineguard
PG_MAX_RUNS=300
PG_MAX_CONCURRENCY=4
PG_RISK_LOW=0.40
PG_RISK_HIGH=0.70
