{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipelineguard-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../dashboard/dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "pipelineguard-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "RAW_BUILDS", "bucket_name": "pipelineguard-raw" }]
}
